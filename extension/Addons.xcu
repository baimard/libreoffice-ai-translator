<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="AddonMenu">
      <node oor:name="org.baimard.libreoffice.ai.translator.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">LibreOffice AI Translator</value><value xml:lang="fr">Traducteur IA LibreOffice</value></prop>
        <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        <node oor:name="Submenu">
          <node oor:name="translate-selection" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.baimard.libreoffice.ai.translator:translate-selection</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Translate selection</value><value xml:lang="fr">Traduire la sélection</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="translate-document" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.baimard.libreoffice.ai.translator:translate-document</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Translate document</value><value xml:lang="fr">Traduire le document</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="cancel-translation" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.baimard.libreoffice.ai.translator:cancel-translation</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Cancel current translation</value><value xml:lang="fr">Annuler la traduction en cours</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="separator" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
          </node>
          <node oor:name="configure" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>org.baimard.libreoffice.ai.translator:configure</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en">Configure…</value><value xml:lang="fr">Configurer…</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
